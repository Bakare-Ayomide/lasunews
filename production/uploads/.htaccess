# Prevent script execution inside the user-uploaded images directory
Options -Indexes -ExecCGI

<FilesMatch "\.(php|php5|php7|php8|phtml|phar|pl|py|jsp|asp|htm|html|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
